# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.venv/
venv/

# Environment (NEVER commit — contains database passwords)
.env
.env.*
**/.env
**/.env.*

# ML model weights (large binary files)
*.onnx
*.pt
*.pth
*.engine
.insightface/

# Database files
*.db
*.db-shm
*.db-wal
*.bak

# Temporary / scratch files
.freebuff/
SmartDetect_IEEE_Paper.docx
SmartDetect_IEEE_Paperr.pages

# Node / Dashboard
node_modules/
dashboard/dist/
package-lock.json

# Logs & debug output
*.log
logs/
debug_err.txt
debug_out.txt
e2e_out.txt
dep_check.txt
stale_files.txt

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Antigravity / brain
brain/

# Snapshots, uploaded videos & temp
snapshots/
uploads/
check_imports.py
fix_deepsort.py

# demo_videos/ is intentionally committed (public MIT sample clips) so a fresh
# clone can run the live demo — force-added despite the *.mp4 rule above
!demo_videos/
!demo_videos/*.mp4

# Offline evaluation harness outputs (regenerable; eval.db can be large)
eval/results/*/eval.db*
eval/results/*/workdir/

# Test/coverage artifacts
.coverage
.pytest_cache/
htmlcov/

# Benchmark + profiling scratch (regenerable)
eval/results/_profile_work/
eval/results/perf/
scratch_verify_flags*

# Evaluation dataset downloads and extraction intermediates.
# eval/data/_dl/ holds the ChokePoint tarballs plus their unpacked copies —
# ~1.1 GB duplicating eval/data/chokepoint/. The corpus is licensed separately
# and must be obtained per eval/adapters/chokepoint.py, never committed.
eval/data/_dl/
eval/data/chokepoint/

# Per-config scratch produced by eval/run_eval.py (throwaway DB + snapshots).
eval/results/**/eval.db
eval/results/**/eval.db-shm
eval/results/**/eval.db-wal
eval/results/**/workdir/
